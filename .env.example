# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB URI (Atlas or local). If blank or fallback enabled, in-memory MongoDB will run automatically for development!
MONGODB_URI=mongodb://127.0.0.1:27017/wasteconnect

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Configuration (Optional for standalone cross-origin client deployments)
# VITE_API_URL=http://localhost:5000/api
