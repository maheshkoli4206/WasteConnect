# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB URI (Atlas or local). For production, set your Atlas connection string.
# Example Atlas format: mongodb+srv://<username>:<password>@cluster.mongodb.net/wasteconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wasteconnect

# JWT Authentication Secret
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend Configuration (Optional for standalone cross-origin client deployments)
# VITE_API_URL=http://localhost:5000/api
